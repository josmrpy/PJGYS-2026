---
import "../styles/global.css";
import { publicUrl } from "../utils/url.js";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Propuestas Legislativas · Parlamento Joven Guía y Scout Costa Rica 2026",
  description = "Repositorio de consulta y análisis de las propuestas legislativas del Parlamento Joven Guía y Scout Costa Rica 2026.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Tipografías: Montserrat (títulos) y Nunito (texto) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Nunito:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" href={publicUrl("favicon.ico")} sizes="any" />
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
